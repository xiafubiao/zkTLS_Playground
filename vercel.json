{
  "version": 2,
  "builds": [
    { "src": "api/*.js", "use": "@vercel/node" },
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1.js" },
    { "src": "/(.*)", "dest": "/public/$1" }
  ],
  "functions": {
    "api/run.js": {
      "includeFiles": [
        "node_modules/@primuslabs/zktls-core-sdk/dist/**/*",
        "node_modules/@primuslabs/zktls-core-sdk/build/**/*",
        "node_modules/@primuslabs/zktls-core-sdk/native/**/*",
        "node_modules/@primuslabs/network-core-sdk/dist/**/*",
        "node_modules/ethers/**/*",
        "node_modules/dotenv/**/*"
      ]
    }
  }
}
