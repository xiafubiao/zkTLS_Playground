<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>zkTLS Playground</title>
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; height: 100vh; display: flex; flex-direction: column; overflow: hidden; background: #fafafa; color: #1a1a1a; }
  .header { display: flex; flex-direction: column; align-items: flex-start; gap: 18px; padding: 24px 32px; background: #ffffff; border-bottom: 1px solid #e5e5e5; flex-shrink: 0; }
  .header-banner { width: 100%; max-height: 180px; overflow: hidden; border-radius: 12px; margin-bottom: 16px; }
  .header-banner img { width: 100%; height: auto; object-fit: cover; object-position: center; }
  .header-top { display: flex; align-items: center; gap: 20px; width: 100%; }
  .header-title { flex: 1; }
  .logo { height: 36px; width: auto; }
  .header-illustration { height: 40px; width: auto; }
  .header h1 { font-size: 24px; font-weight: 700; color: #1a1a1a; margin: 0 0 8px 0; letter-spacing: -0.5px; }
  .header-desc { font-size: 14px; color: #666; line-height: 1.6; max-width: 750px; font-weight: 400; }
  .header-desc a { color: #fd5400; text-decoration: none; font-weight: 500; transition: all 0.2s ease; }
  .header-desc a:hover { color: #fd5400; text-decoration: underline; }
  .header-controls { display: flex; align-items: center; gap: 16px; width: 100%; padding-top: 6px; }
  .header select { background: #ffffff; color: #1a1a1a; border: 1px solid #e5e5e5; border-radius: 8px; padding: 10px 16px; font-size: 14px; font-family: inherit; cursor: pointer; transition: all 0.2s ease; min-width: 180px; font-weight: 500; }
  .header select:hover { border-color: #fd5400; }
  .header select:focus { outline: none; border-color: #fd5400; box-shadow: 0 0 0 3px rgba(253,84,0,0.15); }
  .btn-run { background: #fd5400; color: #fff; border: none; border-radius: 8px; padding: 11px 32px; font-size: 14px; font-family: inherit; cursor: pointer; font-weight: 600; white-space: nowrap; transition: all 0.2s ease; }
  .btn-run:hover { opacity: 0.9; }
  .btn-run:active { transform: translateY(0); }
  .btn-run:disabled { background: #e5e5e5; color: #999; cursor: not-allowed; }
  .spacer { flex: 1; }
  .main { display: flex; flex: 1; overflow: hidden; }
  .editor-pane { flex: 1; display: flex; flex-direction: column; border-right: 1px solid #e5e5e5; background: #ffffff; }
  .side-pane { width: 460px; display: flex; flex-direction: column; overflow: hidden; background: #fafafa; }
  .config-section { padding: 20px 24px; border-bottom: 1px solid #e5e5e5; max-height: 280px; overflow-y: auto; background: #ffffff; }
  .config-section h3 { font-size: 11px; color: #666; margin-bottom: 14px; text-transform: uppercase; letter-spacing: 0.8px; font-weight: 600; }
  .config-row { display: flex; align-items: center; gap: 12px; margin-bottom: 12px; }
  .config-row label { font-size: 13px; color: #666; width: 100px; flex-shrink: 0; font-weight: 500; }
  .config-row input { flex: 1; background: #ffffff; color: #1a1a1a; border: 1px solid #e5e5e5; border-radius: 8px; padding: 10px 14px; font-size: 13px; font-family: inherit; transition: all 0.2s ease; }
  .config-row input:focus { outline: none; border-color: #fd5400; box-shadow: 0 0 0 3px rgba(253,84,0,0.12); }
  .config-row input::placeholder { color: #999; }
  .output-section { flex: 1; display: flex; flex-direction: column; overflow: hidden; }
  .output-header { display: flex; align-items: center; justify-content: space-between; padding: 16px 24px; border-bottom: 1px solid #e5e5e5; background: #ffffff; min-height: 66px; }
  .output-header h3 { font-size: 11px; color: #666; text-transform: uppercase; letter-spacing: 0.8px; font-weight: 600; }
  .output-status { font-size: 12px; color: #666; padding: 6px 14px; border-radius: 16px; background: #f0f0f0; font-weight: 500; }
  .output-status.running { color: #f59e0b; background: #fef3c7; }
  .output-status.success { color: #10b981; background: #d1fae5; }
  .output-status.error { color: #ef4444; background: #fee2e2; }
  .output-console { flex: 1; overflow-y: auto; padding: 20px 24px; font-size: 13px; line-height: 1.8; white-space: pre-wrap; word-break: break-all; background: #ffffff; font-family: 'SF Mono', 'Monaco', 'Menlo', monospace; }
  .output-line { margin-bottom: 3px; color: #1a1a1a; }
  .output-line.stderr { color: #ef4444; }
  .output-line.info { color: #666; }
  #monaco { width: 100%; height: 100%; }
  ::-webkit-scrollbar { width: 8px; height: 8px; }
  ::-webkit-scrollbar-track { background: #f0f0f0; }
  ::-webkit-scrollbar-thumb { background: #d0d0d0; border-radius: 4px; }
  ::-webkit-scrollbar-thumb:hover { background: #b0b0b0; }
  .code-notice { position: relative; padding: 14px 20px; background: #fffbeb; border-bottom: 1px solid #fef3c7; font-size: 13px; line-height: 1.6; color: #92400e; }
  .code-notice strong { color: #d97706; font-weight: 600; }
  .code-notice-close { position: absolute; top: 10px; right: 14px; background: none; border: none; font-size: 18px; color: #d97706; cursor: pointer; padding: 0 6px; line-height: 1; border-radius: 4px; opacity: 0.7; transition: all 0.2s ease; }
  .code-notice-close:hover { opacity: 1; background: #fef3c7; }
  @media (prefers-reduced-motion: reduce) {
    * { animation: none !important; transition: none !important; }
  }
</style>
</head>
<body>

<div class="header">
  <div class="header-banner">
    <img src="img/illus-tx.png" alt="Banner" id="banner-illustration">
  </div>
  <div class="header-top">
    <img src="img/primus-cover.png" alt="Primus" class="logo">
    <img src="img/illus-tx.png" alt="Illustration" class="header-illustration" id="illustration">
    <div class="header-title">
      <h1>Primus zkTLS Playground</h1>
      <p class="header-desc">Use this playground to test Primus zkTLS SDKs directly in your browser, make API requests, and run demo attestations. For complete code examples, visit: <a href="https://github.com/primus-labs/zktls-demo" target="_blank">https://github.com/primus-labs/zktls-demo</a></p>
    </div>
  </div>
  <div class="header-controls">
    <select id="sdk-select">
      <option value="zktls-core-sdk">zktls-core-sdk</option>
      <option value="network-core-sdk">network-core-sdk (on-chain)</option>
    </select>
    <select id="example-select"></select>
    <button class="btn-run" id="btn-run">Run Code</button>
    <div class="spacer"></div>
  </div>
</div>

<div class="main">
  <div class="editor-pane">
    <div class="code-notice" id="code-notice">
      <strong>Note:</strong> The code you run in this demo environment is a simulation only.<br>
      There may be minor differences to the real Primus zkTLS application.
      <button class="code-notice-close" onclick="document.getElementById('code-notice').style.display='none'">&times;</button>
    </div>
    <div id="monaco"></div>
  </div>
  <div class="side-pane">
    <div id="config-section" class="config-section"></div>
    <div class="output-section">
      <div class="output-header">
        <h3>Output</h3>
        <span class="output-status" id="output-status">idle</span>
      </div>
      <div class="output-console" id="output-console"></div>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/monaco-editor@0.45.0/min/vs/loader.js"></script>
<script>
const ILLUSTRATIONS = {
  'zktls-core-sdk': 'img/illus-tx.png',
  'network-core-sdk': 'img/illus-payment.png'
};

const DEFAULTS = {
  "zktls-core-sdk": {},
  "network-core-sdk": {
    chainId: "84532",
    rpcUrl: "https://sepolia.base.org",
  },
};

const EXAMPLES = {
  "okx-instruments": {
    name: "OKX Instruments (BTC-USD)",
    url: "https://www.okx.com/api/v5/public/instruments?instType=SPOT&instId=BTC-USD",
    fields: [
      { keyName: "instType", parsePath: "$.data[0].instType" },
      { keyName: "instId", parsePath: "$.data[0].instId" },
      { keyName: "baseCcy", parsePath: "$.data[0].baseCcy" },
      { keyName: "quoteCcy", parsePath: "$.data[0].quoteCcy" },
    ],
  },
  "okx-ticker": {
    name: "OKX Ticker (BTC-USDT price)",
    url: "https://www.okx.com/api/v5/market/ticker?instId=BTC-USDT",
    fields: [
      { keyName: "last", parsePath: "$.data[0].last" },
      { keyName: "bidPx", parsePath: "$.data[0].bidPx" },
      { keyName: "askPx", parsePath: "$.data[0].askPx" },
    ],
  },
  "coingecko": {
    name: "CoinGecko (BTC price)",
    url: "https://api.coingecko.com/api/v3/simple/price?vs_currencies=usd&ids=bitcoin",
    fields: [
      { keyName: "btcUsd", parsePath: "$.bitcoin.usd" },
    ],
  },
  "binance-ticker": {
    name: "Binance (BTCUSDT price)",
    url: "https://api.binance.com/api/v3/ticker/price?symbol=BTCUSDT",
    fields: [
      { keyName: "symbol", parsePath: "$.symbol" },
      { keyName: "price", parsePath: "$.price" },
    ],
  },
  "github-repo": {
    name: "GitHub (Primus repo stars)",
    url: "https://api.github.com/repos/primus-labs/zktls-core-sdk",
    fields: [
      { keyName: "stars", parsePath: "$.stargazers_count" },
      { keyName: "forks", parsePath: "$.forks_count" },
    ],
  },
};

function zktlsCoreTemplate(ex) {
  const resolves = ex.fields.map(f =>
    '    { keyName: "' + f.keyName + '", parseType: "json", parsePath: "' + f.parsePath + '" },'
  ).join("\n");

  return [
    'import { PrimusCoreTLS } from "@primuslabs/zktls-core-sdk";',
    '',
    'async function main() {',
    '  console.log("=== zkTLS Core SDK - ' + ex.name + ' ===\\n");',
    '',
    '  const zkTLS = new PrimusCoreTLS();',
    '  await zkTLS.init(process.env.APP_ID, process.env.APP_SECRET, "auto");',
    '  console.log("[1/4] SDK initialized");',
    '',
    '  const request = {',
    '    url: "' + ex.url + '",',
    '    method: "GET",',
    '    header: { "user-agent": "Mozilla/5.0" },',
    '    body: "",',
    '  };',
    '',
    '  const responseResolves = [',
    resolves,
    '  ];',
    '',
    '  const attRequest = zkTLS.generateRequestParams(',
    '    request, responseResolves, "0x0000000000000000000000000000000000000000"',
    '  );',
    '  attRequest.setAttMode({ algorithmType: "proxytls", resultType: "plain" });',
    '  console.log("[2/4] Request params generated");',
    '  console.log("      URL:", request.url);',
    '',
    '  console.log("[3/4] Starting attestation...");',
    '  const attestation = await zkTLS.startAttestation(attRequest, 2 * 60 * 1000);',
    '  console.log("      Attestation received!");',
    '',
    '  const ok = zkTLS.verifyAttestation(attestation);',
    '  console.log("[4/4] Local verify:", ok);',
    '  console.log();',
    '',
    '  const data = JSON.parse(attestation.data);',
    '  console.log("========== Proven Data ==========");',
    '  console.log(JSON.stringify(data, null, 2));',
    '  console.log("\\nAttestor:", attestation.attestors?.[0]?.attestorAddr);',
    '  console.log("Signature:", attestation.signatures?.[0]);',
    '  console.log("Timestamp:", attestation.timestamp);',
    '}',
    '',
    'await main().catch(err => console.error("[ERROR]", err.message || err));',
    ''
  ].join("\n");
}

function networkCoreTemplate(ex) {
  const resolves = ex.fields.map(f =>
    '    { keyName: "' + f.keyName + '", parseType: "json", parsePath: "' + f.parsePath + '" },'
  ).join("\n");

  return [
    "require('dotenv').config();",
    "const { PrimusNetwork } = require('@primuslabs/network-core-sdk');",
    "const { ethers } = require('ethers');",
    "",
    "const requests = [{",
    "  url: '" + ex.url + "',",
    "  method: 'GET',",
    "  header: { 'user-agent': 'Mozilla/5.0' },",
    "  body: '',",
    "}];",
    "",
    "const responseResolves = [[",
    resolves,
    "]];",
    "",
    "async function main() {",
    '  console.log("=== Network Core SDK - ' + ex.name + ' ===\\n");',
    "",
    "  const provider = new ethers.providers.JsonRpcProvider(process.env.RPC_URL);",
    "  const wallet = new ethers.Wallet(process.env.PRIVATE_KEY, provider);",
    '  console.log("[1/6] Wallet:", wallet.address);',
    "",
    "  const primusNetwork = new PrimusNetwork();",
    "  await primusNetwork.init(wallet, Number(process.env.CHAIN_ID));",
    '  console.log("[2/6] SDK initialized on chain", process.env.CHAIN_ID);',
    "",
    "  const submitTaskParams = { address: wallet.address };",
    "  const submitTaskResult = await primusNetwork.submitTask(submitTaskParams);",
    '  console.log("[3/6] Task submitted:", submitTaskResult.taskId);',
    "",
    '  console.log("[4/6] Starting attestation...");',
    "  const attestResult = await primusNetwork.attest({",
    "    ...submitTaskParams, ...submitTaskResult,",
    "    requests, responseResolves,",
    "    attMode: { algorithmType: 'proxytls' },",
    "  });",
    '  console.log("      Attestation received!");',
    "",
    "  const result = attestResult[0];",
    "  const data = JSON.parse(result.attestation.data);",
    '  console.log("[5/6] Verified data:");',
    "  console.log(JSON.stringify(data, null, 2));",
    "",
    '  console.log("[6/6] Polling on-chain...");',
    "  const taskResult = await primusNetwork.verifyAndPollTaskResult({",
    "    taskId: result.taskId, reportTxHash: result.reportTxHash,",
    "  });",
    '  console.log("      On-chain confirmed!");',
    "",
    '  console.log("\\n========== Summary ==========");',
    '  console.log("Data:", JSON.stringify(data));',
    '  console.log("TaskId:", result.taskId);',
    '  console.log("ReportTxHash:", result.reportTxHash);',
    '  console.log("Attestor:", result.attestor);',
    "}",
    "",
    "(async () => { await main().catch(err => console.error('[ERROR]', err.message || err)); })();",
    ""
  ].join("\n");
}

let editor, isRunning = false;

function getCurrentSDK() { return document.getElementById("sdk-select").value; }
function getCurrentExample() { return document.getElementById("example-select").value; }

function getConfig() {
  const sdk = getCurrentSDK();
  const config = {};
  if (sdk === "network-core-sdk") {
    config.chainId = document.getElementById("cfg-chainId")?.value || "";
    config.rpcUrl = document.getElementById("cfg-rpcUrl")?.value || "";
  }
  return config;
}

function renderConfig() {
  const sdk = getCurrentSDK();
  const d = DEFAULTS[sdk];
  const el = document.getElementById("config-section");
  document.getElementById('illustration').src = ILLUSTRATIONS[sdk];
  document.getElementById('banner-illustration').src = ILLUSTRATIONS[sdk];
  
  if (sdk === "zktls-core-sdk") {
    el.innerHTML = '<h3>zktls-core-sdk Config</h3>' +
      '<div class="config-row" style="margin-bottom:12px;"><label style="width:auto;">API credentials loaded from server environment</label></div>';
  } else {
    el.innerHTML = '<h3>network-core-sdk Config</h3>' +
      '<div class="config-row" style="margin-bottom:8px;"><label style="width:auto;">Wallet private key loaded from server environment</label></div>' +
      '<div class="config-row"><label>ChainId</label><input id="cfg-chainId" value="' + d.chainId + '"></div>' +
      '<div class="config-row"><label>RPC URL</label><input id="cfg-rpcUrl" value="' + d.rpcUrl + '"></div>';
  }
}

function loadCode() {
  const sdk = getCurrentSDK();
  const ex = EXAMPLES[getCurrentExample()];
  if (!ex) return;
  const code = sdk === "zktls-core-sdk" ? zktlsCoreTemplate(ex) : networkCoreTemplate(ex);
  editor.setValue(code);
}

function renderExampleSelect() {
  const sel = document.getElementById("example-select");
  sel.innerHTML = Object.entries(EXAMPLES).map(([k, v]) =>
    '<option value="' + k + '">' + v.name + '</option>'
  ).join("");
}

function appendOutput(text, cls) {
  const c = document.getElementById("output-console");
  const line = document.createElement("div");
  line.className = "output-line " + (cls || "");
  line.textContent = text;
  c.appendChild(line);
  c.scrollTop = c.scrollHeight;
}

function clearOutput() { document.getElementById("output-console").innerHTML = ""; }

function setStatus(text, cls) {
  const el = document.getElementById("output-status");
  el.textContent = text;
  el.className = "output-status " + (cls || "");
}

function handleOutput(msg) {
  if (msg.type === "stdout") { appendOutput(msg.data); }
  else if (msg.type === "stderr") {
    if (msg.data.includes("|INFO|") || msg.data.includes("|ERROR|")) appendOutput(msg.data, "info");
    else appendOutput(msg.data, "stderr");
  }
  else if (msg.type === "status") { appendOutput(msg.data, "info"); }
  else if (msg.type === "done") {
    isRunning = false;
    document.getElementById("btn-run").disabled = false;
    document.getElementById("btn-run").textContent = "Run";
    if (msg.exitCode === 0) { setStatus("success", "success"); appendOutput("\n[Process exited: 0]", "info"); }
    else { setStatus("error", "error"); appendOutput("\n[Process exited: " + msg.exitCode + "]", "stderr"); }
  }
}

async function runCode() {
  if (isRunning) return;
  isRunning = true;
  clearOutput();
  setStatus("running", "running");
  document.getElementById("btn-run").disabled = true;
  document.getElementById("btn-run").textContent = "Running...";

  try {
    const res = await fetch("/api/run", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        code: editor.getValue(),
        sdk: getCurrentSDK(),
        config: getConfig(),
      }),
    });

    if (!res.ok) {
      throw new Error("HTTP " + res.status);
    }

    const reader = res.body.getReader();
    const decoder = new TextDecoder();
    let buffer = "";

    while (true) {
      const { done, value } = await reader.read();
      if (done) break;
      buffer += decoder.decode(value, { stream: true });
      const lines = buffer.split("\n");
      buffer = lines.pop();
      for (const line of lines) {
        if (!line.trim()) continue;
        try { handleOutput(JSON.parse(line)); } catch {}
      }
    }
    if (buffer.trim()) {
      try { handleOutput(JSON.parse(buffer)); } catch {}
    }
  } catch (err) {
    appendOutput("API Error: " + err.message, "stderr");
    isRunning = false;
    document.getElementById("btn-run").disabled = false;
    document.getElementById("btn-run").textContent = "Run";
    setStatus("error", "error");
  }
}

// Init
require.config({ paths: { vs: "https://cdn.jsdelivr.net/npm/monaco-editor@0.45.0/min/vs" } });
require(["vs/editor/editor.main"], function () {
  editor = monaco.editor.create(document.getElementById("monaco"), {
    value: "",
    language: "javascript",
    theme: "vs",
    fontSize: 13,
    fontFamily: "'SF Mono', 'Monaco', 'Menlo', monospace",
    minimap: { enabled: false },
    scrollBeyondLastLine: false,
    automaticLayout: true,
    tabSize: 2,
  });

  renderExampleSelect();
  renderConfig();
  loadCode();

  document.getElementById("sdk-select").addEventListener("change", () => { renderConfig(); loadCode(); });
  document.getElementById("example-select").addEventListener("change", () => { loadCode(); });
  document.getElementById("btn-run").addEventListener("click", runCode);
});
</script>
</body>
</html>
